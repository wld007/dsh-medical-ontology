{
  "name": "dsh-medical-ontology",
  "version": "0.1.0",
  "description": "临床本体构建：患者级病程本体，以治疗决策为节点（问题线、决策闭环、诊断与疾病关系、归因候选）。读入 dsh-medical-event 的事件包，规则为主、可按日期回看。DeepSeek Harness 插件。",
  "type": "module",
  "license": "MIT",
  "author": "wld007",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wld007/dsh-medical-ontology.git"
  },
  "homepage": "https://github.com/wld007/dsh-medical-ontology#readme",
  "bugs": {
    "url": "https://github.com/wld007/dsh-medical-ontology/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "medical",
    "clinical-ontology",
    "disease-course",
    "clinical-decision",
    "problem-list"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "rules/**/*.mjs",
    "demo/**",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
